<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.EcoHabits" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen theme following Google recommendations -->
    <style name="Theme.EcoHabits.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.EcoHabits</item>
    </style>
</resources>
